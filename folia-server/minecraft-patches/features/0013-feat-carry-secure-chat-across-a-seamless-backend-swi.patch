+     * whatever renders chat, not to the transport.
+     */
+    private static byte[] tesseraEncodeChat(
+        final ServerPlayer sender, final net.minecraft.network.chat.PlayerChatMessage message, final ChatType.Bound chatType
+    ) {
+        final net.minecraft.network.FriendlyByteBuf out = new net.minecraft.network.FriendlyByteBuf(io.netty.buffer.Unpooled.buffer());
+        try {
+            out.writeVarInt(TESSERA_CHAT_RELAY_VERSION);
+            out.writeUUID(sender.getUUID());
+            out.writeUtf(sender.getGameProfile().name());
+            net.minecraft.network.chat.RemoteChatSession.Data.write(out, java.util.Objects.requireNonNull(sender.getChatSession()).asData());
+            out.writeVarInt(message.link().index());
+            out.writeUtf(chatType.chatType().unwrapKey().orElse(ChatType.CHAT).identifier().toString());
+            // The bound name and the decorated content travel as components, not as the sender's
+            // plain name: they are what a chat plugin's renderer produced, so carrying them is what
+            // keeps a relayed line looking like the local one instead of falling back to vanilla
+            // "<name> text". The context-free codec avoids needing registry access on either side.
+            net.minecraft.network.chat.ComponentSerialization.TRUSTED_CONTEXT_FREE_STREAM_CODEC.encode(out, chatType.name());
+            out.writeOptional(chatType.targetName(), net.minecraft.network.chat.ComponentSerialization.TRUSTED_CONTEXT_FREE_STREAM_CODEC::encode);
+            out.writeNullable(message.unsignedContent(), net.minecraft.network.chat.ComponentSerialization.TRUSTED_CONTEXT_FREE_STREAM_CODEC::encode);
+            out.writeNullable(message.signature(), net.minecraft.network.chat.MessageSignature::write);
+
+            final net.minecraft.network.chat.SignedMessageBody body = message.signedBody();
+            out.writeUtf(body.content(), 256);
+            out.writeLong(body.timeStamp().toEpochMilli());
+            out.writeLong(body.salt());
+            out.writeCollection(body.lastSeen().entries(), net.minecraft.network.chat.MessageSignature::write);
+
+            final byte[] bytes = new byte[out.readableBytes()];
+            out.readBytes(bytes);
+            return bytes;
+        } finally {
+            out.release();
+        }
+    }
+    // Tessera end - relay signed chat to the rest of the network
+
     public boolean verifyChatTrusted(final PlayerChatMessage message) {
         return message.hasSignature() && !message.hasExpiredServer(Instant.now());
     }
