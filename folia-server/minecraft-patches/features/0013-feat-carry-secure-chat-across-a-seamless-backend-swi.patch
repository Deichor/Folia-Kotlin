+    // Tessera start - hand the connection's chat state to the next backend
+    private static final int TESSERA_CHAT_STATE_VERSION = 1;
+    private static final int TESSERA_CHAT_STATE_WARN_ENTRIES = 256;
+
+    /**
+     * Snapshots everything about secure chat that lives on this connection rather than on the player.
+     *
+     * A seamless proxy switch sends the client no Login packet, which is the only thing that resets
+     * its own chat state, so the destination inherits a client that is mid-conversation: its signing
+     * chain is at some index, it is still acknowledging messages this backend sent, and it expects
+     * the next {@code ClientboundPlayerChatPacket} to continue a global counter. A destination that
+     * starts fresh disagrees on all three and the player is kicked or silently loses chat. Everything
+     * needed to agree is held here, so the source exports and the destination imports it.
+     *
+     * Opaque bytes on purpose: the transport is a plugin, and keeping the format inside the server
+     * means no NMS type ever has to cross a plugin classloader.
+     *
+     * @return the snapshot, or an empty array when the player has no chat session (offline mode, or a
+     *         client that sent no profile key) and therefore nothing to carry.
+     */
+    public byte[] tesseraExportChatState() {
+        final RemoteChatSession session = this.chatSession;
+        if (session == null) {
+            return new byte[0];
+        }
+
+        final FriendlyByteBuf out = new FriendlyByteBuf(io.netty.buffer.Unpooled.buffer());
+        try {
+            out.writeVarInt(TESSERA_CHAT_STATE_VERSION);
+            RemoteChatSession.Data.write(out, session.asData());
+
+            final SignedMessageChain chain = this.signedMessageChain;
+            out.writeVarInt(chain == null ? -1 : chain.tesseraNextIndex());
+            out.writeLong(chain == null ? 0L : chain.tesseraLastTimeStamp().toEpochMilli());
+            out.writeVarInt(this.nextChatIndex);
+
+            synchronized (this.messageSignatureCache) {
+                final MessageSignature[] cached = this.messageSignatureCache.tesseraExport();
+                out.writeVarInt(cached.length);
+                for (final MessageSignature signature : cached) {
+                    out.writeNullable(signature, MessageSignature::write);
+                }
+            }
+
+            synchronized (this.lastSeenMessages) {
+                final List<LastSeenTrackedEntry> tracked = this.lastSeenMessages.tesseraExport();
+                // Exported whole, never trimmed: the client's acknowledgement offsets are relative to
+                // this exact list, so a shorter one makes the destination reject the first ack and
+                // kick the player. The size is bounded instead by the server's own backlog limit —
+                // past 4096 pending messages the connection is dropped with too_many_pending_chats —
+                // which puts the ceiling near a megabyte. Anything close to that means the client has
+                // stopped acknowledging, so say so rather than moving a silently huge blob.
+                if (tracked.size() > TESSERA_CHAT_STATE_WARN_ENTRIES) {
+                    LOGGER.warn(
+                        "Chat state for {} carries {} unacknowledged messages; the client may have stopped acknowledging",
+                        this.player.getGameProfile().name(),
+                        tracked.size()
+                    );
+                }
+                out.writeVarInt(tracked.size());
+                for (final LastSeenTrackedEntry entry : tracked) {
+                    out.writeNullable(entry, (buf, e) -> {
+                        MessageSignature.write(buf, e.signature());
+                        buf.writeBoolean(e.pending());
+                    });
+                }
+                out.writeNullable(this.lastSeenMessages.tesseraLastPending(), MessageSignature::write);
+            }
+
+            final byte[] bytes = new byte[out.readableBytes()];
+            out.readBytes(bytes);
+            return bytes;
+        } finally {
+            out.release();
+        }
+    }
+
+    /**
+     * Adopts a snapshot taken by {@link #tesseraExportChatState()} on the connection the player just
+     * left. Must run on the main thread and before the client sends anything, which is why the caller
+     * is the seamless-arrival handler rather than the join sequence.
+     *
+     * @throws IllegalArgumentException if the snapshot is malformed or from a newer server
+     */
+    public void tesseraImportChatState(final byte[] snapshot) {
+        if (snapshot.length == 0) {
+            return;
+        }
+
+        final FriendlyByteBuf in = new FriendlyByteBuf(io.netty.buffer.Unpooled.wrappedBuffer(snapshot));
+        final int version = in.readVarInt();
+        if (version != TESSERA_CHAT_STATE_VERSION) {
+            throw new IllegalArgumentException("Unsupported chat state version " + version);
+        }
+
+        final SignatureValidator serviceKeyValidator = this.server.services().profileKeySignatureValidator();
+        if (serviceKeyValidator == null) {
+            LOGGER.warn("Ignoring chat state for {}: no Services public key to validate it against", this.player.getGameProfile().name());
+            return;
+        }
+
+        final RemoteChatSession session;
+        try {
+            session = RemoteChatSession.Data.read(in).validate(this.player.getGameProfile(), serviceKeyValidator);
+        } catch (final ProfilePublicKey.ValidationException e) {
+            // A session that does not validate here would not have validated on the source either, so
+            // this is a transport bug rather than a hostile client; drop the state and let the player
+            // fall back to unsigned chat instead of disconnecting them.
+            LOGGER.warn("Ignoring chat state for {}: {}", this.player.getGameProfile().name(), e.getMessage());
+            return;
+        }
+
+        final int chainIndex = in.readVarInt();
+        final Instant lastTimeStamp = Instant.ofEpochMilli(in.readLong());
+        final int nextChatIndex = in.readVarInt();
+
+        final int cachedCount = in.readVarInt();
+        final MessageSignature[] cached = new MessageSignature[cachedCount];
+        for (int i = 0; i < cachedCount; i++) {
+            cached[i] = in.readNullable(MessageSignature::read);
+        }
+
+        final int trackedCount = in.readVarInt();
+        final List<LastSeenTrackedEntry> tracked = new java.util.ArrayList<>(trackedCount);
+        for (int i = 0; i < trackedCount; i++) {
+            tracked.add(in.readNullable(buf -> new LastSeenTrackedEntry(MessageSignature.read(buf), buf.readBoolean())));
+        }
+        final MessageSignature lastPending = in.readNullable(MessageSignature::read);
+
+        this.chatSession = session;
+        this.hasLoggedExpiry = false;
+        this.signedMessageChain = new SignedMessageChain(this.player.getUUID(), session.sessionId());
+        this.signedMessageChain.tesseraResumeAt(chainIndex, lastTimeStamp);
+        this.signedMessageDecoder = this.signedMessageChain.decoder(session.profilePublicKey());
+        this.nextChatIndex = nextChatIndex;
+
+        synchronized (this.messageSignatureCache) {
+            this.messageSignatureCache.tesseraImport(cached);
+        }
+        synchronized (this.lastSeenMessages) {
+            this.lastSeenMessages.tesseraImport(tracked, lastPending);
+        }
+
+        this.player.setChatSession(session);
+        this.server
+            .getPlayerList()
+            .broadcastAll(
+                new ClientboundPlayerInfoUpdatePacket(EnumSet.of(ClientboundPlayerInfoUpdatePacket.Action.INITIALIZE_CHAT), List.of(this.player)), this.player
+            );
+    }
+    /**
+     * Replays a message relayed from another backend of the network as genuine signed chat.
+     *
+     * <p>The client resolves the sender through its own player-info map and verifies the signature
+     * against the chat session it holds for them, so both have to be pushed first — which is exactly
+     * what {@code INITIALIZE_CHAT} is for, and it may be sent at any time, not only at login. The
+     * entry is added unlisted so a player who is on a different backend does not appear in this
+     * server's tab list.
+     *
+     * <p>Must run on the main thread. Malformed input is dropped with a warning rather than raised:
+     * the peer is another backend, but the blob still crosses a plugin and a network hop.
+     */
+    public void tesseraDeliverRemoteChat(final byte[] blob) {
+        final FriendlyByteBuf in = new FriendlyByteBuf(io.netty.buffer.Unpooled.wrappedBuffer(blob));
+        try {
+            final int version = in.readVarInt();
+            if (version != PlayerList.TESSERA_CHAT_RELAY_VERSION) {
+                LOGGER.warn("Dropping relayed chat with unsupported version {}", version);
+                return;
+            }
+
+            final UUID senderId = in.readUUID();
+            final String senderName = in.readUtf();
+            final com.mojang.authlib.GameProfile senderProfile = new com.mojang.authlib.GameProfile(senderId, senderName);
+            final RemoteChatSession.Data sessionData = RemoteChatSession.Data.read(in);
+
+            final SignatureValidator serviceKeyValidator = this.server.services().profileKeySignatureValidator();
+            if (serviceKeyValidator == null) {
+                return;
+            }
+            final RemoteChatSession session;
+            try {
+                session = sessionData.validate(senderProfile, serviceKeyValidator);
+            } catch (final ProfilePublicKey.ValidationException e) {
+                LOGGER.warn("Dropping relayed chat from {}: {}", senderName, e.getMessage());
+                return;
+            }
+
+            final int linkIndex = in.readVarInt();
+            final ResourceKey<ChatType> chatTypeKey = ResourceKey.create(Registries.CHAT_TYPE, net.minecraft.resources.Identifier.parse(in.readUtf()));
+            final Component boundName = ComponentSerialization.TRUSTED_CONTEXT_FREE_STREAM_CODEC.decode(in);
+            final java.util.Optional<Component> targetName = in.readOptional(ComponentSerialization.TRUSTED_CONTEXT_FREE_STREAM_CODEC::decode);
+            final Component unsignedContent = in.readNullable(ComponentSerialization.TRUSTED_CONTEXT_FREE_STREAM_CODEC::decode);
+            final MessageSignature signature = in.readNullable(MessageSignature::read);
+            final SignedMessageBody body = new SignedMessageBody(
+                in.readUtf(256), Instant.ofEpochMilli(in.readLong()), in.readLong(), new LastSeenMessages(in.readList(MessageSignature::read))
+            );
+
+            introduceRelayedSender(senderId, senderProfile, session);
+
+            // The filter mask is deliberately not relayed: filtering is decided per receiver, and the
+            // source's decision was made for its own players.
+            this.sendPlayerChatMessage(
+                new PlayerChatMessage(
+                    new SignedMessageLink(linkIndex, senderId, session.sessionId()), signature, body, unsignedContent, FilterMask.PASS_THROUGH
+                ),
+                new ChatType.Bound(this.player.level().registryAccess().lookupOrThrow(Registries.CHAT_TYPE).getOrThrow(chatTypeKey), boundName, targetName)
+            );
+        } catch (final RuntimeException e) {
+            LOGGER.warn("Dropping malformed relayed chat: {}", e.toString());
+        }
+    }
+    /**
+     * Makes sure this client can resolve and verify a sender who is on another backend.
+     *
+     * <p>Sent once per sender rather than per message. Repeating it would not merely waste bandwidth:
+     * {@code INITIALIZE_CHAT} rebuilds the client's per-sender validator, so re-sending it before
+     * every message would paper over an out-of-order relay instead of letting the chain reject it.
+     *
+     * <p>The entry is unlisted, so a player on a different backend does not appear in this server's
+     * tab list — but the client still files them under its social manager, which is what keeps the
+     * message reportable and the "hide messages from this player" toggle working.
+     */
+    private void introduceRelayedSender(final UUID senderId, final com.mojang.authlib.GameProfile profile, final RemoteChatSession session) {
+        // A sender who is also on this server already has a real, listed entry; re-adding them would
+        // fight the normal join bookkeeping.
+        if (this.server.getPlayerList().getPlayer(senderId) != null || !this.relayedSenders.add(senderId)) {
+            return;
+        }
+
+        this.send(
+            new ClientboundPlayerInfoUpdatePacket(
+                EnumSet.of(
+                    ClientboundPlayerInfoUpdatePacket.Action.ADD_PLAYER,
+                    ClientboundPlayerInfoUpdatePacket.Action.INITIALIZE_CHAT,
+                    ClientboundPlayerInfoUpdatePacket.Action.UPDATE_LISTED
+                ),
+                List.of(new ClientboundPlayerInfoUpdatePacket.Entry(senderId, profile, false, 0, GameType.DEFAULT_MODE, null, true, 0, session.asData()))
+            )
+        );
+
+        while (this.relayedSenders.size() > MAX_RELAYED_SENDERS) {
+            final java.util.Iterator<UUID> oldest = this.relayedSenders.iterator();
+            final UUID evicted = oldest.next();
+            oldest.remove();
+            // Never withdraw someone who has since joined this server for real — vanilla owns their
+            // entry now, and removing it would erase them from the tab list.
+            if (this.server.getPlayerList().getPlayer(evicted) == null) {
+                this.send(new ClientboundPlayerInfoRemovePacket(List.of(evicted)));
+            }
+        }
+    }
+    // Tessera end - hand the connection's chat state to the next backend
+
